# Copy to .env.local and fill in from Supabase dashboard → Project Settings → API Keys / Data API.
# Never commit .env.local. The service_role / secret key is NOT needed by this app; don't add it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public URL of the site. Used for email-confirmation and Google sign-in redirects.
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "on" after enabling the Google provider in Supabase (Auth → Providers → Google).
NEXT_PUBLIC_GOOGLE_AUTH=off
